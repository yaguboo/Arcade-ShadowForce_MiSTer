set_global_assignment -name VERILOG_FILE ../../../../../third_party/audio/jt6295/jt6295_rom.v
set_global_assignment -name VERILOG_FILE ../../../../../third_party/audio/jt6295/jt6295_serial.v
set_global_assignment -name VERILOG_FILE ../../../../../third_party/audio/jt6295/jt6295_sh_rst.v
set_global_assignment -name VERILOG_FILE ../../../../../third_party/audio/jt6295/jt6295_timing.v

# ---- sound board ----------------------------------------------------------
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/sound/sf_sound.sv

