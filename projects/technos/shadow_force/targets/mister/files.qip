# ---- OKI M6295 (jt6295, GPLv3, (c) Jose Tejada Gomez) ---------------------
# jotego/jt6295 @ 7d76b0be8cd8f85f3ae741178c9830b20e2071a1, unmodified.
# Upstream's hdl/jt6295.qip MINUS its last line, which points at
# ../../jtframe/hdl/sound/jtframe_fir_mono.v in a different repository.  The
# default INTERPOL=0 never instantiates it.  **INTERPOL MUST STAY 0.**
set_global_assignment -name VERILOG_FILE ../../../../../third_party/audio/jt6295/jt12_comb.v
set_global_assignment -name VERILOG_FILE ../../../../../third_party/audio/jt6295/jt12_interpol.v
set_global_assignment -name VERILOG_FILE ../../../../../third_party/audio/jt6295/jt6295.v
set_global_assignment -name VERILOG_FILE ../../../../../third_party/audio/jt6295/jt6295_acc.v
set_global_assignment -name VERILOG_FILE ../../../../../third_party/audio/jt6295/jt6295_adpcm.v
